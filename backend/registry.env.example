# Copy to backend/.env.registry (gitignored). Generate distinct random values locally.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REGISTRY_ADMIN_TOKEN=
REGISTRY_READER_TOKEN=
REGISTRY_HEALTH_WORKER_TOKEN=
REGISTRY_DATABASE_URL=sqlite:///registry-data/registry.sqlite3
REGISTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REGISTRY_VENDOR_SESSION_HOURS=12
REGISTRY_API_URL=http://127.0.0.1:8001
# Run one standalone health worker. Requires FFmpeg, no analytics models.
REGISTRY_HEALTH_INTERVAL_SECONDS=600
REGISTRY_HEALTH_STALE_SECONDS=1800
REGISTRY_HEALTH_FAILURE_THRESHOLD=3
REGISTRY_HEALTH_RECOVERY_THRESHOLD=2
REGISTRY_HEALTH_RETENTION_DAYS=7
REGISTRY_HEALTH_CONCURRENCY=4
REGISTRY_HEALTH_PROBE_TIMEOUT=12
# Exact operator-approved hostnames/IPs for manually registered RTSP streams.
# Sentinel uses its approved connector origin instead.
REGISTRY_HEALTH_ALLOWED_HOSTS=
# Quality metrics are always collected. Enable alerts only after local calibration.
REGISTRY_HEALTH_DARK_RATIO=0
REGISTRY_HEALTH_BLUR_THRESHOLD=0
REGISTRY_HEALTH_FREEZE_ALERTS=0
# Used only by scripts/seed_vendor_accounts.py. The API stores only password hashes.
REGISTRY_VENDOR_DEFAULT_PASSWORD=
# Used only by scripts/seed_dashboard_accounts.py for local role demos.
REGISTRY_DASHBOARD_DEFAULT_PASSWORD=

# Only operators can configure connector destinations and credential bindings.
# Source creation references "sentinel"; credentials are never stored in registry tables.
REGISTRY_CONNECTORS_JSON={"sentinel":{"catalogue_url":"https://cctv.corp8.cloud/cameras.json","login_url":"https://cctv.corp8.cloud/auth/login","credentials_prefix":"SENTINEL","rtsp_origin":"rtsp://103.250.160.189:8554","hls_origin":"https://cctv.corp8.cloud","whep_origin":"http://103.250.160.189:8889","rtsp_path_template":"/stream/{camera_id}","hls_path_template":"/live/stream/{camera_id}/index.m3u8","whep_path_template":"/stream/{camera_id}/whep"}}
SENTINEL_EMAIL=
SENTINEL_PASSWORD=
SENTINEL_HOST=
